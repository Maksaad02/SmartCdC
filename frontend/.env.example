# Variables lues AU BUILD par Vite (elles sont figees dans le bundle JavaScript) :
# ne jamais y mettre de secret. Copier vers .env.local pour le developpement.

# URL de l'API backend. En production derriere le proxy nginx du front : /api
VITE_API_URL=http://localhost:8080/api

# URL du service chatbot (RAG). Vide en production : le proxy nginx sert /chat.
VITE_CHATBOT_API_URL=http://localhost:8082
