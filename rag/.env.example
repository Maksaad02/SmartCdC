# Copier vers .env (ignore par Git). Le service refuse de demarrer si l'une de
# ces variables obligatoires est absente en profil "prod".

# --- OpenAI ---
# Cle projet dediee a cette application, avec une limite de depense mensuelle
# configuree dans le dashboard OpenAI.
OPENAI_API_KEY=

# --- PostgreSQL / pgvector ---
DATABASE_URL=jdbc:postgresql://pgvector:5432/recouvrag_db
DATABASE_USERNAME=recouv_rag
DATABASE_PASSWORD=

# --- Backend SmartCDC ---
BACKEND_BASE_URL=http://backend:8080
# Doit etre identique a CHATBOT_API_KEY cote backend (au moins 32 caracteres).
# Generer avec : openssl rand -base64 32
BACKEND_API_KEY=

# Cle PUBLIQUE RSA correspondant a JWT_PRIVATE_KEY du backend (./scripts/generate-jwt-keys.sh).
# Elle ne permet que de VERIFIER un jeton : le chatbot ne peut pas en fabriquer.
JWT_PUBLIC_KEY=

# --- Origine du front autorisee par CORS ---
FRONTEND_ORIGIN=https://smartcdc.example.com
