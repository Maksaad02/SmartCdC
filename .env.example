# SmartCDC — configuration de la pile Docker.
# cp .env.example .env  puis renseigner. Ce fichier est ignore par Git : ne jamais le commiter.
# `docker compose up` refuse de demarrer si une variable obligatoire manque.

# --- Acces public ---
# URL a laquelle les utilisateurs ouvrent l'application (sert d'origine CORS).
PUBLIC_URL=https://smartcdc.example.com
# Port HTTP publie sur l'hote (le TLS est termine par votre reverse proxy).
HTTP_PORT=80

# --- MySQL (donnees metier) ---
MYSQL_ROOT_PASSWORD=
MYSQL_USER=recouv_app
MYSQL_PASSWORD=

# --- PostgreSQL / pgvector (base vectorielle du chatbot) ---
POSTGRES_DB=recouvrag_db
POSTGRES_USER=recouv_rag
POSTGRES_PASSWORD=

# --- Secrets applicatifs ---
# Paire de cles RSA de signature des jetons : ./scripts/generate-jwt-keys.sh affiche les deux lignes.
# PRIVEE : uniquement pour le backend (qui emet les jetons). PUBLIQUE : donnee au chatbot (il ne fait que verifier).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Cookie de session : true (defaut) exige HTTPS. false seulement pour un essai en HTTP pur, sans TLS.
COOKIE_SECURE=true
# Cle de service backend <-> chatbot (32 caracteres minimum) : openssl rand -base64 32
CHATBOT_API_KEY=

# --- SMTP (mot de passe d'application Gmail) ---
MAIL_USERNAME=
MAIL_PASSWORD=

# --- OpenAI ---
# Cle dediee a ce projet, avec une limite de depense mensuelle dans le dashboard.
OPENAI_API_KEY=

# --- Anthropic (import automatique des factures PDF) ---
# Optionnel : vide, le bouton « Importer une facture (PDF) » est masque. Cle dediee, avec limite de depense.
ANTHROPIC_API_KEY=

# --- Premier compte administrateur (utilise seulement si aucun utilisateur n'existe) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur
