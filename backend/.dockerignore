# Ignore everything by default
*

# Allow these specific files/directories
!src/
!pom.xml
!mvnw
!.mvn/
!target/*.jar
!Dockerfile
!docker-compose.yml
!application.properties
!application.yml

# Explicit exclusions (even if allowed above)
**/target/classes/
**/target/generated-sources/
**/target/test-classes/
**/.git
**/.gitignore
**/*.iml
**/*.log
**/node_modules/
**/.idea/
**/.settings/
**/.project
**/.classpath
**/.vscode/
**/bin/
**/build/
**/out/
**/logs/
**/*.md
**/*.bak
**/*.swp
**/docker-compose.override.yml
**/config/development/
**/src/test/
# Env files
.env