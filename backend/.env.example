# Copy to .env (git-ignored) and fill in. The app fails fast at startup if any of these are unset.

# --- Database ---
# Create a non-root application user; do not reuse the MySQL root account.
DB_URL=jdbc:mysql://localhost:3306/rec_ouv_db?serverTimezone=UTC&useSSL=true&requireSSL=false
DB_USERNAME=recouv_app
DB_PASSWORD=

# --- JWT signing key (RS256) ---
# RSA private key (PKCS#8), PEM or single-line base64. Generate with: ./scripts/generate-jwt-keys.sh
# Only the backend holds it. The chatbot gets the matching PUBLIC key (JWT_PUBLIC_KEY in rag/.env).
# Rotating it invalidates all existing tokens (users sign in again).
JWT_PRIVATE_KEY=

# Session cookie: leave true behind HTTPS; false only for a plain-HTTP test deployment.
APP_COOKIE_SECURE=true

# --- SMTP (Gmail app password) ---
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Browser origins allowed by CORS (comma separated) ---
# Required in production; without it the API accepts no cross-origin browser call.
# Not needed when the front-end proxy serves /api on the same origin.
CORS_ALLOWED_ORIGINS=https://smartcdc.example.com

# --- Shared secret for the RAG chatbot's /api/external/** calls ---
# Generate with: openssl rand -base64 32 (at least 32 characters, enforced at startup)
# Must match CHATBOT_API_KEY / BACKEND_API_KEY in the RecouvChat_Rag service.
CHATBOT_API_KEY=

# --- Invoice PDF import ---
# Optional. The first key set, in this order, reads invoices: ANTHROPIC_API_KEY, OPENROUTER_API_KEY,
# OPENAI_API_KEY. With none, the "Importer une facture (PDF)" feature is disabled.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
OPENAI_API_KEY=

# --- First-run admin bootstrap (AdminInitializer) ---
# Only used when the utilisateur table is empty; ignored afterwards.
# Since /api/register is now ADMIN-only, this is how the first account is created.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur
